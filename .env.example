# Copy to .env. Vite exposes only VITE_-prefixed vars to the client.

# poh-backend REST API base URL
VITE_API_URL=http://localhost:4000

# MediaPipe liveness (optional — defaults to the official CDN + model bucket).
# Override to self-host under public/ for a fully offline / reproducible setup.
# VITE_MEDIAPIPE_WASM_URL=/mediapipe/wasm
# VITE_FACE_LANDMARKER_MODEL_URL=/mediapipe/face_landmarker.task

# --- Issuance mode ---
# auto (default): ask the backend (/health -> issuanceMode). Or force: semaphore | legacy.
# In semaphore mode the browser derives a Semaphore identity from a wallet signature and sends only
# its public commitment with /api/validate. In legacy mode the old ProofOfHumanity flow is used.
# VITE_ISSUANCE_MODE=auto

# --- Chain (semaphore mode: delegation page) ---
# Chain id: 11155111 = Sepolia (default), 31337 = local anvil.
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# Addresses from poh-contracts deployments/local.json (or your testnet deployment).
# VITE_HUMANITY_ISSUER_ADDRESS=0x...
# VITE_DELEGATION_REGISTRY_ADDRESS=0x...
# Optional: Semaphore contract (default: read from HumanityIssuer.semaphore()).
# VITE_SEMAPHORE_ADDRESS=0x...
# The group is rebuilt from events: start at the issuer's deployment block, and set the chunk size to
# your RPC provider's eth_getLogs block-range cap (0 = a single query).
# VITE_SEMAPHORE_START_BLOCK=0
# VITE_LOG_CHUNK_BLOCKS=0
# Block explorer base URL for tx links (default: Sepolia Etherscan on chain 11155111, none otherwise).
# VITE_EXPLORER_URL=

# --- Zero-knowledge proving artifacts ---
# Default /semaphore: files served from public/semaphore (fetch them once with `npm run artifacts`;
# `npm run dev` / `npm run build` try to fetch them automatically). `cdn` = proof artifacts from the
# PSE CDN (https://snark-artifacts.pse.dev/semaphore/4.0.0) at proving time; or any base URL.
# VITE_SEMAPHORE_ARTIFACTS_URL=/semaphore
